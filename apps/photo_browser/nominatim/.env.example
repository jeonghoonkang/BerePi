# Copy to .env and set a random DB password, or run: python3 docker_service.py init
NOMINATIM_PASSWORD=
NOMINATIM_IMAGE=mediagis/nominatim:5.3
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
PBF_URL=https://download.geofabrik.de/asia/south-korea-latest.osm.pbf
IMPORT_STYLE=admin
THREADS=2
GUNICORN_WORKERS=1
SHM_SIZE=1gb
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_AUTOVACUUM_WORK_MEM=256MB
POSTGRES_WORK_MEM=16MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
