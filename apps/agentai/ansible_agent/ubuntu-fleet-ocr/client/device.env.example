# Copy to /root/sononet-device.env and fill in device-specific credentials.
# Trusted shell assignments only; quote values containing spaces/special characters.
# manual: enter any ID below or use install.sh --device-id MY-DEVICE-01.
# Optional server allocation: install.sh --server-id (requires server settings below).
SONONET_ID_MODE=manual
SONONET_DEVICE_ID=
# Default: save the ID locally without contacting the ID server.
SONONET_FETCH_DEVICE_TOKEN=0
# Optional credentials for periodic reporting/conflict checks.
DEVICE_TOKEN=
# Set this only for --server-id or SONONET_FETCH_DEVICE_TOKEN=1.
FLEET_ENROLLMENT_TOKEN=
SONONET_REPO_URL=https://github.com/jeonghoonkang/BerePi.git
SONONET_REPO_BRANCH=master
SONONET_PLAYBOOK_PATH=apps/agentai/ansible_agent/ubuntu-fleet-ocr/local.yml
SONONET_VERIFY_COMMIT=0

NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=CHANGE_ME
NEXTCLOUD_APP_PASSWORD=CHANGE_ME
# Empty => /Fleet/<device ID>
NEXTCLOUD_REMOTE_PATH=
NEXTCLOUD_LOCAL_DIR=/var/lib/sononet/sync

OCR_API_BASE_URL=https://ocr.example.com
OCR_API_KEY=CHANGE_ME
OCR_MODEL=google/gemma-4-31B-it
OCR_INPUT_SUBDIR=inbox
OCR_OUTPUT_SUBDIR=ocr-results
OCR_MAX_FILES_PER_RUN=25
OCR_MAX_FILE_BYTES=20971520
OCR_STABLE_AGE_SECONDS=30
OCR_STATE_DB=/var/lib/sononet/ocr-state.sqlite3

# Optional status/conflict server, e.g. https://fleet.example.com
FLEET_API_URL=
# ID issuance/authentication server; empty => FLEET_API_URL above.
# HTTPS host, optional port and reverse-proxy prefix, e.g. https://id.example.com:8443/fleet
FLEET_ID_API_URL=
# Paths appended to the ID server URL. Configure matching routes on the server/proxy.
FLEET_ID_REGISTER_PATH=/v1/devices/register
FLEET_ID_MANUAL_PATH=/v1/devices/manual
