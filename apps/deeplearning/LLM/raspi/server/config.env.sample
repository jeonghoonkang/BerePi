# Bash environment file. install.sh creates config.env and appends a random API key.
GEMMA4_SERVER_HOST=0.0.0.0
GEMMA4_SERVER_PORT=8082
OLLAMA_PORT=11435
OLLAMA_MODEL=gemma4:e4b
OLLAMA_CONTEXT_LENGTH=2048
GEMMA4_NUM_THREAD=4
GEMMA4_MAX_TOKENS=512
GEMMA4_OCR_MAX_TOKENS=2048
GEMMA4_REQUEST_TIMEOUT=1800
OLLAMA_KEEP_ALIVE=5m
AUTO_PULL=1

# Web login; an empty password uses GEMMA4_API_KEY.
GEMMA4_LOGIN_USER=admin
GEMMA4_LOGIN_PASSWORD=
